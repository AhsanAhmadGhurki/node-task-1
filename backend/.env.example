PORT=3000
APP_URL=http://localhost:3000
# invite email ka link <FRONTEND_URL>/invitations/<token>
FRONTEND_URL=http://localhost:5173
# sirf development: register/login/invite ke jawab mein code/token (Postman/Newman ke liye); production mein mana
# EXPOSE_DEV_OTP=true
API_KEY=
MONGO_URI=
JWT_SECRET=
# production (NODE_ENV=production) mein SMTP_USER/SMTP_PASS zaroori — warna server start nahi hota
# development mein optional — na do to Gmail (smtp.gmail.com:465); user/pass khaali hon to email nahi jaati, code console mein
# NODE_ENV=production
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
